entity:SetCallback("OnSpawned", function()
	print("Entity has spawned")
	local sound = game.Workspace["A-25"].RushNew.Spawn:Play()
	local sound = game.Workspace["A-25"].RushNew.PlaySound:Play()
	local sound = game.Workspace["A-25"].RushNew.PlaySound2:Play()
	local sound = game.Workspace["A-25"].RushNew.PlaySound3:Play()
	local entity = game.Workspace["A-25"]
	local part = game.Workspace["A-25"].RushNew
	-- variables

	local rn = Random.new()

	while entity:GetAttribute("Enabled") == true do
		local posintensity = 0.8
		local rotateintensity = 13
		local delaytime = entity:GetAttribute("Delay")
		task.wait(delaytime)
		entity.RushNew:WaitForChild("Entity").StudsOffset = Vector3.new(rn:NextNumber(-posintensity, posintensity), rn:NextNumber(-posintensity, posintensity), 0)
