entity:SetCallback("OnDamagePlayer", function(newHealth: number)
	if newHealth <= 0 then
		print("Entity has killed the player")
		local jumpscareSound = Instance.new("Sound")
		jumpscareSound.Name = "Jumpscare"
		jumpscareSound.SoundId = "rbxassetid://6459610652"
		jumpscareSound.Volume = 10
		jumpscareSound.PlaybackSpeed = 1.4
		jumpscareSound.Parent = workspace
		jumpscareSound:Play()

		-- Tự động dọn dẹp Sound sau 5 giây để tránh rác dung lượng
		game:GetService("Debris"):AddItem(jumpscareSound, 5)

		local dis = Instance.new("DistortionSoundEffect")
		dis.Level = 1
		dis.Enabled = true
		dis.Parent = jumpscareSound

		local pitch = Instance.new("PitchShiftSoundEffect")
		pitch.Octave = 0.62
		pitch.Enabled = true
		pitch.Parent = jumpscareSound

		local chorus = Instance.new("ChorusSoundEffect")
		chorus.Depth = 0.15
		chorus.Mix = 0.5
		chorus.Rate = 0.5
		chorus.Enabled = true
		chorus.Parent = jumpscareSound

		local echo = Instance.new("EchoSoundEffect")
		echo.Delay = 0.02
		echo.Feedback = 1
		echo.Enabled = true
		echo.Parent = jumpscareSound

		local userInterface = game:GetService("UserInputService")
		local Players = game:GetService("Players")
		local TweenService = game:GetService("TweenService")

		local player = Players.LocalPlayer
		local playerGui = player:WaitForChild("PlayerGui")
		local rng = Random.new()

		-- Tạo ScreenGui
		local screenGui = Instance.new("ScreenGui")
		screenGui.Name = "JumpscareGui"
		screenGui.ResetOnSpawn = false
		screenGui.IgnoreGuiInset = true
		screenGui.DisplayOrder = 999999
		screenGui.Parent = playerGui

		-- Tạo background
		local background = Instance.new("Frame")
		background.Name = "Background"
		background.Size = UDim2.fromScale(1, 1)
		background.Position = UDim2.fromScale(0, 0)
		background.BackgroundColor3 = Color3.new(0, 0, 0)
		background.BorderSizePixel = 0
		background.Parent = screenGui

		-- Tạo ImageLabel
		local imageLabel = Instance.new("ImageLabel")
		imageLabel.Name = "ImageLabel"
		imageLabel.BackgroundTransparency = 1
		imageLabel.AnchorPoint = Vector2.new(0.5, 0.5)
		imageLabel.Position = UDim2.fromScale(0.5, 0.5)
		imageLabel.Size = UDim2.new(0, 0.001, 0, 0.001)
		imageLabel.Image = "rbxassetid://15683707568"
		imageLabel.ZIndex = 2
		imageLabel.Parent = screenGui -- ĐÃ SỬA: Gán Parent cho ImageLabel xuất hiện

		local fullTween = TweenService:Create(
			imageLabel,
			TweenInfo.new(0.7, Enum.EasingStyle.Linear, Enum.EasingDirection.Out),
			{
				Size = UDim2.new(0, 1250, 0, 1250)
			}
		)

		fullTween:Play()

		-- ĐÃ SỬA: Kiểm tra xem thiết bị có phải là Mobile/Cảm ứng không
		if userInterface.TouchEnabled and not userInterface.KeyboardEnabled then
			-- Chế độ dành cho Điện thoại / Máy tính bảng
			for i = 1, 60 do
				local mode = rng:NextInteger(1, 3)

				if mode == 1 then
					background.BackgroundColor3 = Color3.new(0, 1, 0)
					imageLabel.ImageColor3 = Color3.new(0, 1, 0)
					imageLabel.Position = UDim2.new(rng:NextNumber(0.2, 0.8), 0, rng:NextNumber(0.2, 0.8), 0)
				elseif mode == 2 then
					background.BackgroundColor3 = Color3.new(0, 0.760784, 0)
					imageLabel.ImageColor3 = Color3.new(0, 0, 0)
					imageLabel.Position = UDim2.new(rng:NextNumber(0.2, 0.8), 0, rng:NextNumber(0.2, 0.8), 0)
				else
					background.BackgroundColor3 = Color3.new(0, 0, 0)
					imageLabel.ImageColor3 = Color3.new(0, 0.760784, 0)
					imageLabel.Position = UDim2.new(rng:NextNumber(0.2, 0.8), 0, rng:NextNumber(0.2, 0.8), 0)
				end

				imageLabel.Rotation = rng:NextInteger(-10, 10)
				task.wait()
			end
		else
			-- Chế độ dành cho Máy tính (PC/Laptop)
			for i = 1, 140 do
				local mode = rng:NextInteger(1, 3)

				if mode == 1 then
					background.BackgroundColor3 = Color3.new(0, 1, 0)
					imageLabel.ImageColor3 = Color3.new(0, 1, 0)
					imageLabel.Position = UDim2.new(rng:NextNumber(0.4, 0.6), 0, rng:NextNumber(0.4, 0.6), 0)
				elseif mode == 2 then
					background.BackgroundColor3 = Color3.new(0, 0.760784, 0)
					imageLabel.ImageColor3 = Color3.new(0, 0, 0)
					imageLabel.Position = UDim2.new(rng:NextNumber(0.4, 0.6), 0, rng:NextNumber(0.4, 0.6), 0)
				else
					background.BackgroundColor3 = Color3.new(0, 0, 0)
					imageLabel.ImageColor3 = Color3.new(0, 0.760784, 0)
					imageLabel.Position = UDim2.new(rng:NextNumber(0.4, 0.6), 0, rng:NextNumber(0.4, 0.6), 0)
				end

				imageLabel.Rotation = rng:NextInteger(-10, 10)
				task.wait()
			end
		end

		-- Dọn dẹp GUI sau khi thực hiện xong jumpscare
		screenGui:Destroy()
	else
		print("Entity has damaged the player")
	end
end)

